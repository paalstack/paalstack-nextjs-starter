{
  "name": "paalstack-nextjs-starter",
  "version": "1.0.0",
  "description": "Production-ready Next.js starter with Supabase template for SaaS, enterprise, admin dashboards, and AI-powered applications — built with Next.js 16, React 19, Tailwind CSS v4, and @paalstack/react-ui",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0 --no-warn-ignored --cache",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" --cache",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "commit": "cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf .next node_modules/.cache",
    "clean:all": "rm -rf .next node_modules pnpm-lock.yaml"
  },
  "keywords": [
    "nextjs",
    "nextjs-16",
    "react",
    "react-19",
    "typescript",
    "tailwindcss",
    "tailwind-css-v4",
    "supabase",
    "tanstack-query",
    "zustand",
    "zod",
    "react-hook-form",
    "vitest",
    "playwright",
    "paalstack",
    "boilerplate",
    "starter",
    "template",
    "saas",
    "enterprise",
    "app-router",
    "server-components",
    "turbopack"
  ],
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@paalstack/react-hooks": "^1.1.1",
    "@paalstack/react-icons": "^1.1.0",
    "@paalstack/react-ui": "^1.2.2",
    "@sentry/nextjs": "^10.64.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.102.5",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "posthog-js": "^1.420.0",
    "posthog-node": "^5.40.0",
    "react-is": "^19.2.7",
    "resend": "^6.23.0",
    "next": "^16.3.2",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^17.6.7",
    "@eslint/js": "^9.18.0",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.5",
    "@tanstack/react-query-devtools": "^5.102.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.3.0",
    "tsx": "^4.23.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "author": {
    "name": "Paalamugan",
    "email": "paalamugan@paalstack.com"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
