# ──────────────────────────────────────────────────────────────────────────────
# PaalStack Next.js Starter — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEXT_PUBLIC_* variables are exposed to the browser.
# All variables are validated at startup via @t3-oss/env-nextjs + Zod.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PaalStack"

# Enable verbose debug logging in the browser console (true | false)
NEXT_PUBLIC_DEBUG_MODE=false

# ── Backend API ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1

# ── Supabase (optional — disabled by default) ────────────────────────────────
# Uncomment when enabling Supabase: see README "Enabling Supabase" section.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_ACCESS_TOKEN=

# ── Database / Drizzle ORM (optional) ─────────────────────────────────────────
# Uncomment when enabling Drizzle: see README "Enabling Drizzle ORM" section.
#
# DATABASE_URL=postgresql://postgres.[project-id]:***@aws-0-[region].pooler.supabase.com:6543/postgres

# ── AI (optional) ─────────────────────────────────────────────────────────────
# AI_PROVIDER=openrouter
# AI_API_KEY=
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_BASE_URL=

# ── Email delivery via Resend (optional) ──────────────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=PaalStack <onboarding@paalstack.com>

# ── Error monitoring via Sentry (optional) ────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=

# ── Product analytics via PostHog (optional) ──────────────────────────────────
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com